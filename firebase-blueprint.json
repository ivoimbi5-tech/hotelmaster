{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "A hotel room",
      "type": "object",
      "properties": {
        "number": { "type": "string", "description": "Room number" },
        "type": { "type": "string", "description": "Room type (e.g., Single, Double, Suite)" },
        "pricePerHour": { "type": "number", "description": "Price per hour" },
        "status": { "type": "string", "enum": ["available", "occupied", "cleaning", "maintenance"], "description": "Current status of the room" },
        "currentBookingId": { "type": "string", "description": "ID of the active booking if occupied" }
      },
      "required": ["number", "type", "pricePerHour", "status"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A room booking record",
      "type": "object",
      "properties": {
        "roomId": { "type": "string", "description": "Reference to the room" },
        "guestId": { "type": "string", "description": "Reference to the guest" },
        "guestName": { "type": "string", "description": "Guest name for logs" },
        "guestPhone": { "type": "string", "description": "Guest phone for logs" },
        "checkInTime": { "type": "string", "format": "date-time", "description": "ISO timestamp of check-in" },
        "checkOutTime": { "type": "string", "format": "date-time", "description": "ISO timestamp of check-out (null if active)" },
        "cardId": { "type": "string", "description": "RFID tag ID" },
        "totalHours": { "type": "integer", "description": "Calculated total hours" },
        "totalAmount": { "type": "number", "description": "Calculated total price" },
        "status": { "type": "string", "enum": ["active", "completed"], "description": "Status of the booking" },
        "reservationDeposit": { "type": "number", "description": "Deposit paid during reservation" }
      },
      "required": ["roomId", "guestId", "checkInTime", "status", "guestName", "guestPhone"]
    },
    "Guest": {
      "title": "Guest",
      "description": "Hotel guest information",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Full name" },
        "phone": { "type": "string", "description": "Phone number" },
        "documentNumber": { "type": "string", "description": "Optional document number" },
        "lastCardId": { "type": "string", "description": "Last used RFID card ID" }
      },
      "required": ["name", "phone"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "An online reservation",
      "type": "object",
      "properties": {
        "roomId": { "type": "string" },
        "guestName": { "type": "string" },
        "guestPhone": { "type": "string" },
        "arrivalTime": { "type": "string", "format": "date-time" },
        "depositPaid": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "checked-in", "expired", "cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["roomId", "guestName", "guestPhone", "arrivalTime", "status"]
    }
  },
  "firestore": {
    "/rooms": { "schema": "Room", "description": "Collection of hotel rooms" },
    "/bookings": { "schema": "Booking", "description": "Collection of bookings" },
    "/guests": { "schema": "Guest", "description": "Collection of guests" },
    "/reservations": { "schema": "Reservation", "description": "Online reservations" }
  }
}
